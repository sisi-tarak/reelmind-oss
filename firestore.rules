rules_version = '2';

// ReelMind sync: each signed-in person can read and write only their own folder.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && collection in ['items', 'cards', 'boards', 'digests', 'layouts', 'edits', 'devices']
        && request.resource.data.keys().hasOnly(['data', 'hash', 'updatedAt', 'v'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
