# Copy this file to .env and fill in at least one key.

# ── Gemini (default, free) ────────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey
# Gemini watches each reel's video and hears the speech. It also links related reels by meaning.
GEMINI_API_KEY=
# Optional: up to 4 more keys. When one reaches its limit, the next takes over automatically.
# Make each key in a different Google Cloud project (aistudio.google.com/apikey, "Create API key in new project"),
# because keys in the same project share one quota.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Model that watches and analyzes each reel. Check https://ai.google.dev/gemini-api/docs/models
# for the newest free-tier Flash model and change this when a better one ships.
GEMINI_MODEL=gemini-3.8-flash
# If Google says the model is overloaded (503 "high demand"), ReelMind waits and retries 3 times.
# Optionally name a lighter model to try for that reel instead, e.g. a "flash-lite" model.
GEMINI_FALLBACK_MODEL=
GEMINI_EMBED_MODEL=gemini-embedding-2

# Max AI calls per minute. Keep these at or below your free-tier limits.
GEMINI_RPM=8
GEMINI_EMBED_RPM=60

# ── Claude (optional, bring your own key) ────────────────────────────────
# Key from https://platform.claude.com (billed per use; a Claude Pro chat plan does not include API access).
# Claude reads still frames and the caption (it can't hear audio), and writes strong topic boards and quizzes.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_RPM=20

# Which AI analyzes new reels by default: gemini or claude. You can also pick per batch in the app.
AI_PROVIDER=gemini

# ── Downloading reels ─────────────────────────────────────────────────────
# Instagram often needs you to be signed in to download a reel.
# Pick the browser you're signed in to Instagram with: chrome, firefox, edge, brave, safari
YTDLP_COOKIES_BROWSER=
# Or point to an exported cookies.txt file instead.
YTDLP_COOKIES_FILE=

# ── Helper ────────────────────────────────────────────────────────────────
# Address of the hosted ReelMind site, used to print your one-click connect link.
REELMIND_APP_URL=https://reelmind-tau.vercel.app

# Where downloaded reels, transcripts and analyses are cached. Default: ./data in the repo.
REELMIND_DATA_DIR=

# ── Use ReelMind from your phone while away ──────────────────────────────
# on = start a free, secure Cloudflare tunnel so your phone can reach this helper from anywhere.
# Needs cloudflared: "winget install --id Cloudflare.cloudflared" (Windows) or "brew install cloudflared" (Mac).
# The helper prints a phone link (and the app shows a QR code). Everything through it needs your connect code.
REELMIND_TUNNEL=
# Or a fixed HTTPS address you set up yourself, e.g. Tailscale Serve: https://your-pc.your-tailnet.ts.net
REELMIND_PUBLIC_URL=

# Port for the local helper.
PORT=5317
